  "differences_from_baseline": "Only third-family dispatch/CLI choice plus corresponding docstrings in shared worker/evaluate. New official PI05 model/runtime/text-only tokenizer and strict restoration added. Queue, physics, rendering, ROS broker and episode scheduler unchanged. Native generation50 differs from pi0-FAST10 but same execution E10. Existing35 records are not rewritten.",
  "shared_source_unified_diff": {
    "experiments/realtime_vla/worker.py": "--- baseline/experiments/realtime_vla/worker.py\n+++ pi05-addition/experiments/realtime_vla/worker.py\n@@ -32,7 +32,7 @@\n def model_process(family,modeldir,incoming,outgoing,ros_transport=False,ros_port=8780):\n     \"\"\"Own GPU initialization and execute serialized chunk requests.\n \n-    Args: family/modeldir: frozen artifact; incoming/outgoing: bounded queues.\n+    Args: family/modeldir: frozen SmolVLA, pi0-FAST or pi0.5 artifact; incoming/outgoing: bounded queues.\n     Returns: None on shutdown. Raises: Errors are sent as explicit results.\n     Design:\n         Context: Forking after graphics initialization can corrupt CUDA state.\n@@ -61,6 +61,9 @@\n         elif family=='pi0fast':\n             from pi0fast_runtime import FrozenPI0Fast\n             runtime=FrozenPI0Fast(modeldir,device='cuda')\n+        elif family=='pi05':\n+            from pi05_runtime import FrozenPI05\n+            runtime=FrozenPI05(modeldir,device='cuda')\n         else:raise ValueError('unknown model family')\n         outgoing.put({'kind':'ready','startup_seconds':time.perf_counter()-start})\n         while True:\n",
    "experiments/realtime_vla/evaluate.py": "--- baseline/experiments/realtime_vla/evaluate.py\n+++ pi05-addition/experiments/realtime_vla/evaluate.py\n@@ -217,7 +217,8 @@\n def main():\n     \"\"\"Evaluate one model at a time with identical environment and scheduler settings.\n \n-    Args: CLI. Returns: None; writes immutable run directory and audited summary.\n+    Args: CLI --model smolvla/pi0fast/pi05 plus fixed run settings.\n+    Returns: None; writes immutable run directory and audited summary.\n     Raises: Initialization failures before episode execution.\n     Design:\n         Context: RTX5080 memory and resource contention affect latency.\n@@ -236,7 +237,7 @@\n     ADR: None.\n     \"\"\"\n     parser=argparse.ArgumentParser(description=__doc__.splitlines()[0])\n-    parser.add_argument('--model',choices=['smolvla','pi0fast'],required=True)\n+    parser.add_argument('--model',choices=['smolvla','pi0fast','pi05'],required=True)\n     parser.add_argument('--modeldir',type=Path)\n     parser.add_argument('--output',type=Path,required=True)\n     parser.add_argument('--initial-states',type=int,nargs='+',default=[0])\n"
  },
