                "type": "VISUAL",
                "shape": [
                    3,
                    224,
                    224
                ]
            },
            "observation.images.empty_camera_0": {
                "type": "VISUAL",
                "shape": [
                    3,
                    224,
                    224
                ]
            },
            "observation.state": {
                "type": "STATE",
                "shape": [
                    32
                ]
            }
        },
